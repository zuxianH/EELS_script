{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research evidence record",
  "type": "object",
  "required": ["schema_version", "record_id", "task_id", "project", "site", "authoring_tool", "code_revision", "created_at", "status", "scope", "claim", "evidence", "next_action"],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "site": {"type": "string", "minLength": 1},
    "authoring_tool": {"type": "string", "minLength": 1},
    "code_revision": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["observed", "hypothesis", "verified", "superseded"]},
    "scope": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "criterion": {"type": "string"},
    "next_action": {"type": "string", "minLength": 1}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "verified"}}},
    "then": {"required": ["criterion"], "properties": {
      "criterion": {"type": "string", "minLength": 1},
      "evidence": {"type": "array", "minItems": 1}
    }}
  }]
}
